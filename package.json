{
  "name": "neon-apex",
  "version": "1.0.0",
  "private": true,
  "description": "A street racing game for the browser, by day in the mountains or at night in the city, with AI rivals that drive a racing line computed from the track.",
  "license": "MIT",
  "author": "Ravi Kumar Gupta",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "stats": "tsx scripts/stats.ts",
    "cars": "node scripts/prepare-cars.mjs",
    "diagram": "tsx scripts/diagram.ts",
    "shots": "vite build && tsx scripts/shots.ts && python3 scripts/make_gif.py",
    "trailer": "vite build && tsx scripts/trailer.ts"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "5.3.0",
    "@neondatabase/serverless": "1.2.1",
    "jose": "6.2.18",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
