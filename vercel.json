{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "apex.edward7780.com"
        }
      ],
      "destination": "https://skidline.edward7780.com/:path+",
      "permanent": true
    }
  ]
}
